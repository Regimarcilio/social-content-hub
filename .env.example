# Variáveis de ambiente — Social Content Hub
# Copie este arquivo para .env e preencha os valores.
# NÃO commite o arquivo .env.

# OpenRouter (modelos gratuitos via provedores compatíveis com OpenCode)
OPENROUTER_API_KEY=sua_chave_aqui
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Modelos por agente (variantes :free)
MODEL_ORCHESTRATOR=nvidia/nemotron-3-ultra-550b-a55b:free
MODEL_RESEARCHER=nvidia/nemotron-3.5-super-vl:free
MODEL_WRITER=google/gemma-4-31b-it:free
MODEL_PLATFORM_ADAPTER=nvidia/nemotron-3.5-lightning:free
MODEL_ART_DIRECTOR=nvidia/nemotron-3.5-super-vl:free
MODEL_QUALITY_REVIEWER=nvidia/nemotron-3-ultra-550b-a55b:free
MODEL_SEO=google/gemma-4-31b-it:free

# Banco de dados (PostgreSQL)
DATABASE_URL=postgresql://usuario:senha@localhost:5432/social_content_hub

# Geração de imagens (ComfyUI local)
COMFYUI_BASE_URL=http://127.0.0.1:8188

# Servidores MCP (quando desenvolvidos próprios)
MCP_FILESYSTEM_ALLOWED_DIRS=./data,./prototypes

# Limites de uso (controle de custos)
MAX_REQUESTS_PER_MINUTE=20
MAX_REQUESTS_PER_DAY=50
CACHE_SEMANTIC_ENABLED=true

# Segurança
ENCRYPTION_KEY=sua_chave_de_criptografia_aqui_32_chars
